# Copy to .env and fill in real values (never commit .env).
# Adobe I/O Runtime reads these at deploy time and injects them into each
# action as encrypted default params (see actions/lib/auth.js and handoff §7).
#
# This is the same shape as .env.stage / .env.prod (the per-workspace
# deployment templates) — one GMC account per file, picked by GMC_ENV. Use
# this file for local `aio app run`/`aio app dev`: point it at whichever
# account you want to exercise locally (e.g. copy .env.stage's values here).
#
# Local-only tooling that talks to the real GMC API without deploying
# (scripts/delete-all-products.js, test/integration) does NOT use this file
# — it loads .env.stage / .env.prod directly by name, since it needs a
# specific, unambiguous account per invocation. See test/integration/README.md
# and the comment atop scripts/delete-all-products.js.

# ---- Adobe I/O Runtime (populated by `aio app init`) ----
AIO_runtime_auth=
AIO_runtime_namespace=
AIO_runtime_apihost=https://adobeioruntime.net

# ---- GMC: this deployment always serves ONE account ----
# GMC_ENV labels which one ('test' or 'prod') — required; resolveAccount
# (actions/lib/config.js) fails closed (500 "server misconfigured") if it's
# missing or invalid. It no longer selects between suffixed variables —
# there's only one GMC_MERCHANT_ACCOUNT_ID / GMC_DATASOURCE_ID per file.
GMC_ENV=
GMC_MERCHANT_ACCOUNT_ID=
GMC_DATASOURCE_ID=
GMC_SERVICE_ACCOUNT_JSON=
GMC_GCP_PROJECT_ID=

# ---- Ops ----
LOG_LEVEL=info
