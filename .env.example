# Copy to .env and fill in real values (never commit .env).
# Adobe I/O Runtime reads these at deploy time and injects them into each
# action as encrypted default params (see actions/lib/auth.js and handoff §7).

# ---- Adobe I/O Runtime (populated by `aio app init`) ----
AIO_runtime_auth=
AIO_runtime_namespace=
AIO_runtime_apihost=https://adobeioruntime.net

# ---- Google Merchant Center credentials (OAuth path — per project decision) ----
GMC_CLIENT_ID=
GMC_CLIENT_SECRET=
GMC_REFRESH_TOKEN=          # minted once with scope https://www.googleapis.com/auth/content

# ---- Alternative auth: uncomment if GMC provisions a service account instead ----
# GMC_SERVICE_ACCOUNT_JSON=

# ---- GMC account + data source IDs (test vs prod) ----
GMC_MERCHANT_ACCOUNT_ID_TEST=
GMC_MERCHANT_ACCOUNT_ID_PROD=
GMC_DATASOURCE_ID_TEST=     # populate after running bootstrap-datasource
GMC_DATASOURCE_ID_PROD=

# ---- Ops ----
SLACK_WEBHOOK_URL=
LOG_LEVEL=info
